# 复制成 .env 后按需修改：cp .env.example .env
# docker compose 会自动读取项目根目录的 .env（该文件已被 .gitignore 忽略）

# 宿主机暴露的端口（容器内部固定 8000，不用改）
# 8000 常被占用，所以默认用 8010；换成服务器上确认空闲的端口即可
KOTONE_PORT=8010

# 每次考试的题量（默认 10 题 × 10 分 = 100 分）
KOTONE_EXAM_SIZE=10

# 监听地址：默认 0.0.0.0（对外可访问）；填 127.0.0.1 则只有宿主机能访问，适合前面挂反向代理做 HTTPS
KOTONE_BIND=0.0.0.0

# 容器名（一般不用改；只有同一台机器要跑第二份实例时才改）
KOTONE_NAME=kotonego
