# 构建镜像时的忽略规则（不影响 git，git 用 .gitignore）
.git
.gitignore
*.md

# 前端：构建阶段会在镜像内 npm ci，本地 node_modules / dist 不要传进 context
frontend/node_modules
frontend/dist
frontend/.env
frontend/.env.*
frontend/*.tsbuildinfo

# 后端：虚拟环境、缓存、本地数据库都不进镜像
backend/.venv
backend/__pycache__
backend/**/__pycache__
backend/**/*.py[cod]
backend/static
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm

# 其他
docker-compose.yml
Dockerfile
.venv
*.log
.DS_Store
data
